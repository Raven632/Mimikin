# ==========================================
# Зависимости (Docker установит их сам)
# ==========================================
node_modules/
api/node_modules/
frontend/node_modules/

# ==========================================
# Локальные сборки (Docker соберет React сам)
# ==========================================
frontend/dist/
frontend/build/

# ==========================================
# Объемные директории (монтируются через volumes)
# ==========================================
games/
_saves/
_tmp_uploads/
.audio-cache/
*.db
*.sqlite

# ==========================================
# Секреты (передаются через docker-compose)
# ==========================================
.env
api/.env
frontend/.env

# ==========================================
# Настройки Git, документация и дизайн
# ==========================================
.git/
.gitignore
.github/
README.md
README.de.md
README.ru.md
LICENSE
rest/

# ==========================================
# Системные файлы и конфигурация Docker
# ==========================================
docker-compose.yml
.DS_Store
