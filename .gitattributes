# ============================================================================
# Переводы строк. Внутри репозитория всё хранится и выдаётся в LF, включая
# Windows: скрипты и unit-файлы systemd с CRLF просто не запускаются, а
# вперемешку CRLF и LF делают diff нечитаемым — правка одной строки показывалась
# как переписанный файл целиком. Двоичные файлы git определяет сам.
# ============================================================================
* text=auto eol=lf

# ============================================================================
# Что не попадает в архивы релиза (git archive / «Source code» на GitHub).
# На клон репозитория это не влияет: разработчику всё остаётся на месте.
# ============================================================================
/tests                export-ignore
/tests/**             export-ignore
api/server.test.js     export-ignore
/scripts              export-ignore
/scripts/**           export-ignore
/deploy               export-ignore
/deploy/**            export-ignore
/.github              export-ignore
/.github/**           export-ignore
docker-compose.dev.yml export-ignore
.gitattributes         export-ignore
.gitignore             export-ignore
