[Unit]
Description=RPG Library: проверка обновлений каждую минуту

[Timer]
# Проверка — один git fetch, секунда работы: раз в минуту не нагружает ни сервер, ни GitHub. Пока идёт сборка,
# новый запуск не начинается (служба oneshot ещё работает)
OnCalendar=*:*:00
# По умолчанию systemd сдвигает запуск на минуту ради экономии — для «раз в минуту» это вдвое дольше
AccuracySec=5s

[Install]
WantedBy=timers.target
